# chick / postgres — copy to .env and fill in. .env is gitignored (see
# servers/chick/.gitignore); this example is committed.

# ── Credentials ────────────────────────────────────────────────────────────
POSTGRES_USER=mk3
POSTGRES_PASSWORD=change-me        # REQUIRED — compose refuses to start unset
POSTGRES_DB=mk3

# ── Where Postgres listens on the host ─────────────────────────────────────
# Default: localhost-only (code runs on chick via Way A). Set PG_BIND=0.0.0.0
# only when a remote host (e.g. barn) must reach it — then mind the firewall.
PG_BIND=127.0.0.1
PG_PORT=5432
