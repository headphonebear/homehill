# chick / valkey — copy to .env and fill in. .env is gitignored (see
# servers/chick/.gitignore); this example is committed. All keys are optional —
# a bare `docker compose up -d` works on the defaults below.

# ── Where Valkey listens on the host ───────────────────────────────────────
# Default: localhost-only. Set VALKEY_BIND=0.0.0.0 only for remote access, and
# then also add --requirepass in the compose command (see the WHY note there).
VALKEY_BIND=127.0.0.1
VALKEY_PORT=6379

# ── Memory ceiling (policy is noeviction — see compose) ────────────────────
VALKEY_MAXMEM=1gb
